{
  "name": "beavy-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/ui": "~58.0.28",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "studio": "cd google-studio && npm run dev",
    "studio:build": "cd google-studio && npm run build",
    "build:web": "expo export --platform web && node ./scripts/prepare-web-app.js",
    "lint": "expo lint",
    "refresh:daily": "node scripts/daily-retailer-refresh.mjs",
    "sync:lidl": "python3 scripts/sync-lidl-prices.py && node scripts/merge-lidl-into-shelf.mjs",
    "catalog:sync": "node ./scripts/sync-canonical-catalog.mjs",
    "catalog:push": "node ./scripts/push-canonical-catalog.mjs"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "private": true
}
